# ==================== Tiannara SaaS Environment Configuration ====================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==================== Application Settings ====================
APP_NAME=Tiannara MindCache SaaS
APP_ENV=development  # development, staging, production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,*.tiannara.com

# ==================== Database Configuration ====================
DATABASE_URL=postgresql://tiannara_user:password@localhost:5432/tiannara_saas
# For SQLite (development only):
# DATABASE_URL=sqlite:///./tiannara.db

# ==================== Payment Provider Configuration ====================

# Default provider (used when no provider specified in API call)
# Options: lemon_squeezy, stripe
# RECOMMENDED: lemon_squeezy (no business registration required)
PAYMENT_PROVIDER=lemon_squeezy

# --- Lemon Squeezy Configuration (RECOMMENDED) ---
# Get these from: https://app.lemonsqueezy.com/settings/api
LEMON_SQUEEZY_API_KEY=eyJwcm9kdWN0aW9uIjoi...
LEMON_SQUEEZY_STORE_ID=12345
LEMON_SQUEEZY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx
LEMON_SQUEEZY_TEST_MODE=true  # Set to false in production

# Lemon Squeezy Variant IDs (from Products page)
# Create products at: https://app.lemonsqueezy.com/products
LS_STARTER_VARIANT_ID=123456
LS_PRO_VARIANT_ID=123457
LS_ENTERPRISE_VARIANT_ID=123458

# --- Stripe Configuration (Alternative/Additional) ---
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Stripe Price IDs (from Products page)
# Create prices at: https://dashboard.stripe.com/products
STRIPE_STARTER_PRICE_ID=price_1ABC...
STRIPE_PRO_PRICE_ID=price_2DEF...
STRIPE_ENTERPRISE_PRICE_ID=price_3GHI...

# NOTE: You can use BOTH providers!
# - Default provider is used when no provider is specified
# - You can override per-transaction by passing "provider" parameter
# - Example: {"plan": "starter", "provider": "stripe"}

# ==================== Authentication & Security ====================
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP Configuration
OTP_SECRET_KEY=your-otp-secret-key
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=100

# ==================== Email Configuration ====================
# Choose one: Resend, SendGrid, or SMTP

# Option 1: Resend (Recommended for simplicity)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@tiannara.com

# Option 2: SendGrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@tiannara.com

# Option 3: SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=your-email@gmail.com

# ==================== CORS Configuration ====================
CORS_ORIGINS=http://localhost:3001,http://localhost:3000,https://app.tiannara.com

# ==================== API Configuration ====================
API_V1_PREFIX=/api/v1
API_TITLE=Tiannara MindCache API
API_VERSION=1.0.0

# ==================== Logging ====================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text

# ==================== Redis (Optional - for caching/sessions) ====================
# REDIS_URL=redis://localhost:6379/0

# ==================== AWS/S3 (Optional - for file storage) ====================
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=tiannara-uploads
# AWS_REGION=us-east-1

# ==================== Monitoring & Analytics ====================
# Sentry (Error Tracking)
# SENTRY_DSN=https://xxxxxxx@oxxxxx.ingest.sentry.io/xxxxx

# PostHog (Analytics)
# POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxx
# POSTHOG_HOST=https://app.posthog.com

# ==================== Feature Flags ====================
ENABLE_WORKSPACES=true
ENABLE_RBAC=true
ENABLE_AUDIT_LOGGING=true
ENABLE_WHITE_LABEL=true
ENABLE_MAPEK_SECURITY=true
ENABLE_ANALYTICS=true

# ==================== Tiannara Core Settings ====================
# Core AI Engine API URL (separate deployment)
CORE_API_URL=http://localhost:8001
CORE_API_KEY=your-core-api-key  # Optional: if Core requires authentication

# WebSocket Configuration
WEBSOCKET_ENABLED=true
WEBSOCKET_HEARTBEAT_INTERVAL=30

# ==================== File Upload Limits ====================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=.jpg,.jpeg,.png,.gif,.pdf,.doc,.docx

# ==================== Backup Configuration ====================
BACKUP_ENABLED=false
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30
# BACKUP_S3_BUCKET=tiannara-backups

# ==================== Development Tools ====================
# Enable Swagger UI in production? (Set to false for security)
SWAGGER_UI_ENABLED=true

# Auto-reload code changes (development only)
AUTO_RELOAD=true

# ==================== Notes ====================
# 
# QUICK START FOR PAYMENTS:
# 1. Sign up at https://lemonsqueezy.com
# 2. Create 3 products (Starter $49, Professional $199, Enterprise $999)
# 3. Copy variant IDs and API key above
# 4. Set PAYMENT_PROVIDER=lemon_squeezy
# 5. Configure webhook URL: https://your-domain.com/api/v1/payment/webhook
# 6. Test with LEMON_SQUEEZY_TEST_MODE=true
# 
# See docs/deployment/PAYMENT_SETUP_GUIDE.md for detailed instructions
#
